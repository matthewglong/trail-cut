{
  "// purpose": "Type-check-only config for the renderer worker. Node CJS context. The page-side script (page/init.ts) is type-checked separately via page/tsconfig.json (DOM lib, no Node types).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.ts",
    "backend.ts",
    "scene.ts",
    "chromeBackend.ts",
    "nativeBackend.ts",
    "fetchUrl.ts",
    "bootstrap.html.ts",
    "trailcutFetch.ts",
    "tileCache.ts",
    "__tests__/setupFixture.ts",
    "../../../src/lib/mapVisuals/**/*.ts",
    "../../../src/lib/cameraIntent.ts",
    "../../../src/lib/routeLocation.ts",
    "../../../src/types.ts",
    "../../../src/theme/tokens.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "page/**",
    "dist/**",
    "node_modules/**"
  ]
}
