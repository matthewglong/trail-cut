+// Exposes mbgl::Map::setGestureInProgress. While true, the transform reports
+// isChanging(), so raster layers use the non-pixel-aligned projection matrix —
+// the equivalent of maplibre-gl-js's `moving` painter flag. Needed by external
+// animation drivers (e.g. per-frame still renders of a moving camera path),
+// which otherwise hit the raster pixel-snap on every frame.
+void NodeMap::SetGestureInProgress(const Nan::FunctionCallbackInfo<v8::Value>& info) {
+    auto nodeMap = Nan::ObjectWrap::Unwrap<NodeMap>(info.Holder());
+    if (!nodeMap->map) return Nan::ThrowError(releasedMessage());
+
+    if (info.Length() <= 0 || !info[0]->IsBoolean()) {
+        return Nan::ThrowTypeError("First argument must be a boolean");
+    }
+
+    try {
+        nodeMap->map->setGestureInProgress(Nan::To<bool>(info[0]).ToChecked());
+    } catch (const std::exception& ex) {
+        return Nan::ThrowError(ex.what());
+    }
+
+    info.GetReturnValue().SetUndefined();
+}
