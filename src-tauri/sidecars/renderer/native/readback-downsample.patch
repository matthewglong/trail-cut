+// Exact-integer box downsample of the color attachment, run on-GPU before
+// readback. Semantics match gfx::HeadlessBackend::ReadbackDownsample (and the
+// CPU fallback in gfx/headless_backend.cpp) bit-for-bit: RGBA8Unorm reads
+// recover exact byte values (unorm→float is correctly rounded, so
+// round(v/255 × 255) == v), the sum stays integral, and (sum + n/2)/n is the
+// same round-half-up the CPU filter applies. Out-of-bounds source reads
+// contribute zero while the divisor stays factor² (zero-pad convention).
+static constexpr const char* kBoxDownsampleMSL = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+kernel void boxDownsample(texture2d<float, access::read> src [[texture(0)]],
+                          texture2d<float, access::write> dst [[texture(1)]],
+                          constant uint& factor [[buffer(0)]],
+                          uint2 gid [[thread_position_in_grid]]) {
+    if (gid.x >= dst.get_width() || gid.y >= dst.get_height()) {
+        return;
+    }
+    const uint sw = src.get_width();
+    const uint sh = src.get_height();
+    const uint n = factor * factor;
+    uint4 sum = uint4(0);
+    for (uint j = 0; j < factor; ++j) {
+        const uint sy = gid.y * factor + j;
+        if (sy >= sh) {
+            continue;
+        }
+        for (uint i = 0; i < factor; ++i) {
+            const uint sx = gid.x * factor + i;
+            if (sx >= sw) {
+                continue;
+            }
+            sum += uint4(round(src.read(uint2(sx, sy)) * 255.0));
+        }
+    }
+    const uint4 avg = (sum + n / 2) / n;
+    dst.write(float4(avg) / 255.0, gid);
+}
+)MSL";
