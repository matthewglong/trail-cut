+PremultipliedImage HeadlessBackend::readStillImage(const std::optional<ReadbackDownsample>& downsample) {
+    PremultipliedImage full = readStillImage();
+    if (!downsample) {
+        return full;
+    }
+    const uint32_t factor = downsample->factor;
+    const uint32_t outW = downsample->width;
+    const uint32_t outH = downsample->height;
+    if (factor == 1 && Size{outW, outH} == full.size) {
+        return full;
+    }
+    const uint32_t n = factor * factor;
+    const uint32_t half = n / 2;
+    const uint32_t srcW = full.size.width;
+    const uint32_t srcH = full.size.height;
+    auto out = std::make_unique<uint8_t[]>(size_t(outW) * outH * 4);
+    const uint8_t* src = full.data.get();
+    std::vector<uint32_t> acc(size_t(outW) * 4);
+    for (uint32_t oy = 0; oy < outH; ++oy) {
+        std::fill(acc.begin(), acc.end(), 0u);
+        for (uint32_t k = 0; k < factor; ++k) {
+            const uint32_t sy = oy * factor + k;
+            if (sy >= srcH) continue; // zero-pad rows contribute nothing
+            const uint8_t* row = src + size_t(sy) * srcW * 4;
+            const uint32_t copyW = std::min(outW * factor, srcW);
+            for (uint32_t sx = 0; sx < copyW; ++sx) {
+                const size_t o = size_t(sx / factor) * 4;
+                const uint8_t* s = row + size_t(sx) * 4;
+                acc[o] += s[0];
+                acc[o + 1] += s[1];
+                acc[o + 2] += s[2];
+                acc[o + 3] += s[3];
+            }
+        }
+        uint8_t* outRow = out.get() + size_t(oy) * outW * 4;
+        for (size_t i = 0; i < size_t(outW) * 4; ++i) {
+            outRow[i] = static_cast<uint8_t>((acc[i] + half) / n);
+        }
+    }
+    return {Size{outW, outH}, std::move(out)};
+}
