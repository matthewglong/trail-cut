+// ---- TrailCut vendored patch 3 — group-composite ---------------------------
+// See mbgl/renderer/group_composite.hpp for the semantics. The mechanism is
+// the heatmap offscreen pattern generalized: members render into a
+// full-viewport RGBA8 offscreen texture (WITH depth+stencil — line layers
+// stencil-clip their tiles), and a fullscreen quad composites that texture
+// src-over at the group opacity, at the topmost member's z-slot.
+
+void Renderer::Impl::setGroupComposites(std::vector<GroupCompositeConfig> configs) {
+    groupComposites.clear();
+    groupCompositeMembers.clear();
+    groupCompositeAnchors.clear();
+    groupComposites.reserve(configs.size());
+    for (auto& config : configs) {
+        GroupCompositeState state;
+        state.config = std::move(config);
+        groupComposites.emplace_back(std::move(state));
+    }
+}
+
+void Renderer::Impl::updateGroupComposites(PaintParameters& parameters) {
+    groupCompositeMembers.clear();
+    groupCompositeAnchors.clear();
+    if (groupComposites.empty()) {
+        return;
+    }
+    auto& context = parameters.context;
+    const auto size = staticData->backendSize;
+
+    for (auto& state : groupComposites) {
+        state.members.clear();
+        state.active = false;
+
+        // Resolve member layer groups by name. visitLayerGroups iterates in
+        // ascending layer-index order, so `members` ends up z-sorted.
+        orchestrator.visitLayerGroups([&](LayerGroupBase& layerGroup) {
+            for (const auto& id : state.config.layers) {
+                if (layerGroup.getName() == id) {
+                    state.members.push_back(&layerGroup);
+                    break;
+                }
+            }
+        });
+        bool anyDrawables = false;
+        for (const auto* member : state.members) {
+            if (member->getDrawableCount() > 0) {
+                anyDrawables = true;
+                break;
+            }
+        }
+        if (state.members.empty() || !anyDrawables) {
+            continue; // nothing to composite this frame — zero overhead
+        }
+
+        if (state.offscreenTexture && state.offscreenTexture->getTexture()->getSize() != size) {
+            // Recreate wholesale on resize: the offscreen owns depth/stencil
+            // attachments too, and the composite drawable holds the texture.
+            state.offscreenTexture.reset();
+            state.compositeGroup.reset();
+        }
+        if (!state.offscreenTexture) {
+            state.offscreenTexture = context.createOffscreenTexture(
+                size, gfx::TextureChannelDataType::UnsignedByte, /*depth=*/true, /*stencil=*/true);
+            state.compositeGroup.reset();
+        }
+        if (!state.shader) {
+            state.shader = context.getGenericShader(*staticData->shaders, "GroupCompositeShader");
+            if (!state.shader) {
+                continue;
+            }
+        }
+        if (!state.compositeGroup) {
+            state.compositeGroup = context.createLayerGroup(
+                state.members.back()->getLayerIndex(), /*initialCapacity=*/1, "group-composite");
+            if (!state.compositeGroup) {
+                continue;
+            }
+            // Fullscreen quad drawable — the heatmap composite recipe minus
+            // the color ramp. The quad statics are shared with heatmap.
+            auto vertices = std::make_shared<gfx::VertexVector<HeatmapTextureLayoutVertex>>(
+                RenderStaticData::heatmapTextureVertices());
+            const auto vertexCount = vertices->elements();
+            auto vertexAttrs = context.createVertexAttributeArray();
+            if (const auto& attr = vertexAttrs->set(shaders::idHeatmapPosVertexAttribute)) {
+                attr->setSharedRawData(std::move(vertices),
+                                       offsetof(HeatmapLayoutVertex, a1),
+                                       /*vertexOffset=*/0,
+                                       sizeof(HeatmapLayoutVertex),
+                                       gfx::AttributeDataType::Short2);
+            }
+            auto builder = context.createDrawableBuilder("group-composite");
+            builder->setShader(std::static_pointer_cast<gfx::ShaderProgramBase>(state.shader));
+            builder->setEnableDepth(false);
+            builder->setColorMode(gfx::ColorMode::alphaBlended());
+            builder->setCullFaceMode(gfx::CullFaceMode::disabled());
+            builder->setRenderPass(RenderPass::Translucent);
+            builder->setVertexAttributes(std::move(vertexAttrs));
+            builder->setRawVertices({}, vertexCount, gfx::AttributeDataType::Short2);
+            SegmentVector segments = RenderStaticData::heatmapTextureSegments();
+            builder->setSegments(
+                gfx::Triangles(), RenderStaticData::quadTriangleIndices().vector(), segments.data(), segments.size());
+            builder->setTexture(state.offscreenTexture->getTexture(), shaders::idHeatmapImageTexture);
+            builder->flush(context);
+            auto* compositeLayerGroup = static_cast<LayerGroup*>(state.compositeGroup.get());
+            for (auto& drawable : builder->clearDrawables()) {
+                compositeLayerGroup->addDrawable(std::move(drawable));
+            }
+        }
