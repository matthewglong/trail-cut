+// TrailCut vendored patch 3 — exposes Renderer::setGroupComposites.
+// Argument: an array of {layers: string[], opacity: number} descriptors; an
+// empty array clears every group. Each group's layers render offscreen at
+// their configured paint opacities and composite over the map ONCE at the
+// group opacity, so translucent self-overlap within the group cannot darken
+// beyond it (group-opacity semantics).
+void NodeMap::SetGroupComposite(const Nan::FunctionCallbackInfo<v8::Value>& info) {
+    auto nodeMap = Nan::ObjectWrap::Unwrap<NodeMap>(info.Holder());
+    if (!nodeMap->map) return Nan::ThrowError(releasedMessage());
+
+    if (info.Length() <= 0 || !info[0]->IsArray()) {
+        return Nan::ThrowTypeError("First argument must be an array of {layers, opacity} groups");
+    }
+
+    std::vector<mbgl::GroupCompositeConfig> configs;
+    auto groups = info[0].As<v8::Array>();
+    for (uint32_t i = 0; i < groups->Length(); ++i) {
+        auto entryValue = Nan::Get(groups, i).ToLocalChecked();
+        if (!entryValue->IsObject()) {
+            return Nan::ThrowTypeError("Each group must be an object with layers/opacity");
+        }
+        auto entry = Nan::To<v8::Object>(entryValue).ToLocalChecked();
+
+        auto layersValue = Nan::Get(entry, Nan::New("layers").ToLocalChecked()).ToLocalChecked();
+        if (!layersValue->IsArray()) {
+            return Nan::ThrowTypeError("Group field 'layers' must be an array of layer id strings");
+        }
+        mbgl::GroupCompositeConfig config;
+        auto layers = layersValue.As<v8::Array>();
+        for (uint32_t j = 0; j < layers->Length(); ++j) {
+            auto layerValue = Nan::Get(layers, j).ToLocalChecked();
+            if (!layerValue->IsString()) {
+                return Nan::ThrowTypeError("Group field 'layers' must contain only strings");
+            }
+            config.layers.emplace_back(*Nan::Utf8String(layerValue));
+        }
+
+        auto opacityValue = Nan::Get(entry, Nan::New("opacity").ToLocalChecked()).ToLocalChecked();
+        if (!opacityValue->IsNumber()) {
+            return Nan::ThrowTypeError("Group field 'opacity' must be a number");
+        }
+        const double opacity = Nan::To<double>(opacityValue).ToChecked();
+        if (!(opacity >= 0.0 && opacity <= 1.0)) {
+            return Nan::ThrowTypeError("Group field 'opacity' must be in [0, 1]");
+        }
+        config.opacity = static_cast<float>(opacity);
+        configs.emplace_back(std::move(config));
+    }
+
+    try {
+        if (auto* renderer = nodeMap->frontend->getRenderer()) {
+            renderer->setGroupComposites(std::move(configs));
+        } else {
+            return Nan::ThrowError("Renderer is not available");
+        }
+    } catch (const std::exception& ex) {
+        return Nan::ThrowError(ex.what());
+    }
+
+    info.GetReturnValue().SetUndefined();
+}
