new file mode 100644
index 0000000..efe2613
--- /dev/null
+++ b/include/mbgl/renderer/group_composite.hpp
@@ -0,0 +1,29 @@
+// TrailCut vendored patch 3 — group-composite configuration.
+//
+// A group composite renders a designated set of style layers (identified by
+// layer id) into a full-viewport offscreen target each frame — at whatever
+// opacities those layers carry — then composites the result over the main
+// framebuffer ONCE, src-over, at `opacity`, at the z-position of the
+// topmost member layer. Because the offscreen pass saturates instead of
+// re-blending against the map, translucent self-overlap within the group
+// (e.g. a route halo crossing itself) cannot exceed the composite opacity:
+// the classic "group opacity" semantics of 2D compositors.
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace mbgl {
+
+struct GroupCompositeConfig {
+    /// Style layer ids forming the group. Members are rendered into the
+    /// offscreen target in their existing z-order and skipped in the main
+    /// passes; the composite draws at the topmost member's slot. Layers
+    /// that don't exist (or aren't currently rendered) are ignored; a group
+    /// with no live members is a no-op.
+    std::vector<std::string> layers;
+    /// Composite opacity in [0, 1], applied once to the whole group.
+    float opacity = 1.0f;
+};
+
+} // namespace mbgl
