+        parameters.renderPass.reset();
+        parameters.encoder->present(*state.offscreenTexture);
+        parameters.scissorRect = prevScissorRect;
+    }
+    // The main pass's stencil attachment starts cleared too — make it
+    // redraw its own clipping masks rather than trusting ours.
+    parameters.resetTileClippingMasks();
