@@ -0,0 +1,98 @@
+// TrailCut vendored patch 3 — group-composite shader (Metal).
+//
+// Composites a group-composite render target (a set of style layers
+// rendered offscreen at full opacity) over the main framebuffer in one
+// src-over pass at a single configurable opacity. The RTT content is
+// premultiplied, so scaling all four channels by `opacity` is the exact
+// "group opacity" composite.
+//
+// Structurally a clone of HeatmapTextureShader minus the color-ramp
+// lookup. The UBO layout and every binding index deliberately mirror the
+// heatmap-texture numerology so the C++ side can reuse
+// HeatmapTexturePropsUBO / idHeatmapTexturePropsUBO / idHeatmapImageTexture
+// / idHeatmapPosVertexAttribute without touching the generated
+// shader_defines tables:
+//   MSL idGroupCompositePropsUBO = drawableReservedUBOCount
+//     == MSL idHeatmapTexturePropsUBO (same value, distinct compilation)
+//   MSL attribute index groupCompositeUBOCount + 0
+//     == heatmapTextureUBOCount + 0
+#pragma once
+
+#include <mbgl/shaders/heatmap_texture_layer_ubo.hpp>
+#include <mbgl/shaders/shader_source.hpp>
+#include <mbgl/shaders/mtl/shader_program.hpp>
+
+namespace mbgl {
+namespace shaders {
+
+constexpr auto groupCompositeShaderPrelude = R"(
+
+enum {
+    idGroupCompositePropsUBO = drawableReservedUBOCount,
+    groupCompositeUBOCount
+};
+
+struct alignas(16) GroupCompositePropsUBO {
+    /*  0 */ float4x4 matrix;
+    /* 64 */ float opacity;
+    /* 68 */ float pad1;
+    /* 72 */ float pad2;
+    /* 76 */ float pad3;
+    /* 80 */
+};
+static_assert(sizeof(GroupCompositePropsUBO) == 5 * 16, "wrong size");
+
+)";
+
+template <>
+struct ShaderSource<BuiltIn::GroupCompositeShader, gfx::Backend::Type::Metal> {
+    static constexpr auto name = "GroupCompositeShader";
+    static constexpr auto vertexMainFunction = "vertexMain";
+    static constexpr auto fragmentMainFunction = "fragmentMain";
+
+    static const std::array<AttributeInfo, 1> attributes;
+    static constexpr std::array<AttributeInfo, 0> instanceAttributes{};
+    static const std::array<TextureInfo, 1> textures;
+
+    static constexpr auto prelude = groupCompositeShaderPrelude;
+    static constexpr auto source = R"(
+
+struct VertexStage {
+    short2 pos [[attribute(groupCompositeUBOCount + 0)]];
+};
+
+struct FragmentStage {
+    float4 position [[position, invariant]];
+    float2 pos;
+};
+
+FragmentStage vertex vertexMain(thread const VertexStage vertx [[stage_in]],
+                                device const GlobalPaintParamsUBO& paintParams [[buffer(idGlobalPaintParamsUBO)]],
+                                device const GroupCompositePropsUBO& props [[buffer(idGroupCompositePropsUBO)]]) {
+
+    const float2 pos = float2(vertx.pos);
+    const float4 position = props.matrix * float4(pos * paintParams.world_size, 0, 1);
+
+    return {
+        .position    = position,
+        .pos         = pos,
+    };
+}
+
+half4 fragment fragmentMain(FragmentStage in [[stage_in]],
+                            device const GroupCompositePropsUBO& props [[buffer(idGroupCompositePropsUBO)]],
+                            texture2d<float, access::sample> image [[texture(0)]],
+                            sampler image_sampler [[sampler(0)]]) {
+
+#if defined(OVERDRAW_INSPECTOR)
+    return half4(1.0);
+#endif
+
+    const float4 color = image.sample(image_sampler, in.pos);
+    return half4(color * props.opacity);
+}
+)";
+};
+
+} // namespace shaders
+} // namespace mbgl
